            "expression": "focused",
            "facial": "mustache"
          }
        ],
        "color": "#f7c23a"
      }
    },
    {
      "text": "He sorted them by color and checked each under a microscope.",
      "scene": {
        "kind": "title",
        "text": "A microscope",
        "sub": "Checking every stone",
        "color": "#ec6a9c"
      }
    },
    {
      "text": "One mauve stone looked like spinel, which bends light one way.",
      "scene": {
        "kind": "reveal",
        "item": "gem",
        "shape": "cushion",
        "tone": "#b49ad8",
        "label": "A mauve stone",
        "color": "#5bb4e8"
      }
    },
    {
      "text": "It bent light two ways, so it was something else.",
      "scene": {
        "kind": "title",
        "text": "Bent twice",
        "sub": "Double refraction",
        "color": "#c8dc3c"
      }
    },
    {
      "text": "London lab tests confirmed a new mineral, named taaffeite in 1951.",
      "say": "London lab tests confirmed a new mineral, named taaffeite in nineteen fifty-one.",
      "scene": {
        "kind": "cast",
        "setting": "lab",
        "name": "Basil Anderson",
        "role": "Tested it in London",
        "cast": [
          {
            "outfit": "coat",
            "outfitColor": "#8a4a5a",
            "hair": "short",
            "hairColor": "#3a2a1e",
            "skin": "#d9a87e",
            "expression": "proud",
            "facial": "beard"
          }
        ],
        "color": "#f0552e"
      }
    },
    {
      "text": "It is the first mineral identified from a cut gem.",
      "scene": {
        "kind": "reveal",
        "item": "gem",
        "shape": "oval",
        "tone": "#b49ad8",
        "label": "Found cut",
        "color": "#f7c23a"
      }
    },
    {
      "text": "Its colors range from lilac and violet to pink and red.",
