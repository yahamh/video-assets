        "color": "#a98be0"
      }
    },
    {
      "text": "In 1945, gemologist Richard Taaffe bought a box of old stones.",
      "say": "In nineteen forty-five, gemologist Richard Taaffe bought a box of old stones.",
      "scene": {
        "kind": "cast",
        "setting": "study",
        "name": "Richard Taaffe",
        "role": "A Dublin gemologist",
        "cast": [
          {
            "outfit": "suit",
