        "stone": "amethyst",
        "metal": "yellow",
        "label": "The crash story"
      }
    },
    {
      "text": "The story says Cartier then copied the damage.",
      "scene": {
        "kind": "piece",
        "piece": "earrings",
        "stone": "emerald",
        "cut": "pear",
        "metal": "yellow",
        "label": "Copied the damage"
      }
    },
    {
