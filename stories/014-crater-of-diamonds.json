    },
    {
      "text": "It was a white diamond of 2.3 carats.",
      "say": "It was a white diamond of two point three carats.",
      "scene": {
        "kind": "mine",
        "ground": "field",
        "carats": 2.3,
        "zoomAt": 0.05,
        "color": "#ec6a9c"
      }
    },
    {
      "text": "She told her partner, I hunted this for you.",
      "scene": {
        "kind": "gift",
        "stone": "rough",
        "to": "I hunted this for you",
