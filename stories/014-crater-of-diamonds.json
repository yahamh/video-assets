    {
      "text": "She dug up her own engagement diamond.",
      "scene": {
        "kind": "hook",
        "show": "rough",
        "color": "#4cc3a8"
      }
    },
    {
      "text": "Crater of Diamonds State Park in Arkansas sits on an old volcano.",
