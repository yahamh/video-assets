            "hair": "slick",
            "hairColor": "#3a2a1e",
            "skin": "#efc9a6",
            "expression": "proud",
            "facial": "mustache"
          }
        ]
      }
    },
    {
      "text": "In 2013, the Osenat auction house in Fontainebleau offered it.",
      "say": "In twenty thirteen, the Oh-zuh-nah auction house in Fontainebleau offered it.",
      "scene": {
        "kind": "cast",
        "setting": "study",
        "name": "Osenat",
        "role": "Fontainebleau, 2013",
        "color": "#5bb4e8",
        "cast": [
          {
            "outfit": "suit",
            "outfitColor": "#2a2f3d",
            "hair": "slick",
            "hairColor": "#3a2a1e",
            "skin": "#c98e6a",
            "expression": "smile",
            "prop": "letter"
          }
        ]
      }
    },
    {
      "text": "It was expected to bring about $20,000.",
      "say": "It was expected to bring about twenty thousand dollars.",
      "scene": {
        "kind": "title",
        "text": "$20,000",
        "sub": "The estimate",
        "color": "#c8dc3c"
      }
    },
    {
      "text": "Osenat said the estimate left out Napoleon and Josephine.",
      "say": "Oh-zuh-nah said the estimate left out Napoleon and Josephine.",
      "scene": {
        "kind": "reveal",
        "item": "gem",
        "shape": "pear",
        "tone": "#2a4fb0",
        "label": "The Napoleon part",
        "light": "#fff2c4",
        "color": "#ec6a9c"
      }
    },
    {
      "text": "The winning bid was $949,000, almost fifty times that.",
      "say": "The winning bid was nine hundred forty-nine thousand dollars, almost fifty times that.",
      "scene": {
        "kind": "title",
        "text": "$949,000",
        "sub": "The winning bid",
        "color": "#f7c23a"
      }
