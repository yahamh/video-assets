            "jewel": "pendant",
            "jewelTone": "#2a4fb0"
          }
        ]
      }
    },
    {
      "text": "Family tradition says he gave her this toi et moi ring.",
      "say": "Family tradition says he gave her this twah ay mwah ring.",
      "scene": {
        "kind": "gift",
        "stone": "pear",
        "tone": "#2a4fb0",
        "to": "Josephine",
        "date": "From Napoleon",
        "color": "#f7c23a"
      }
    },
    {
      "text": "The name means you and me.",
      "scene": {
        "kind": "title",
        "text": "Toi et moi",
        "sub": "You and me",
        "color": "#a98be0"
      }
    },
    {
      "text": "A pear-shaped sapphire and a pear-shaped diamond sit side by side.",
      "scene": {
        "kind": "cut",
        "phase": "result",
        "place": "Side by side",
        "color": "#4cc3a8",
        "pieces": [
          {
            "shape": "pear",
            "size": 0.8,
            "tone": "#2a4fb0"
          },
          {
            "shape": "pear",
            "size": 0.8
          }
        ]
      }
    },
    {
      "text": "Each is about a carat, set on a slim gold band.",
      "scene": {
        "kind": "jewel",
        "piece": "ring",
        "shape": "pear",
        "tone": "#2a4fb0",
        "metal": "yellow",
        "label": "A slim gold band",
        "color": "#f0552e"
      }
    },
    {
      "text": "It went to her daughter Hortense, then to Hortense's son,",
      "scene": {
        "kind": "portrait",
        "name": "Hortense",
        "years": "Josephine's daughter",
        "hair": "updo",
        "hairColor": "#3a2a1e",
        "pearls": true,
        "dress": "#a98be0",
        "bg": "#f7c23a",
        "color": "#4cc3a8"
      }
    },
    {
      "text": "who became Napoleon the Third.",
      "scene": {
        "kind": "cast",
        "setting": "palace",
        "name": "Napoleon the Third",
        "role": "Hortense's son",
        "color": "#ec6a9c",
        "cast": [
          {
