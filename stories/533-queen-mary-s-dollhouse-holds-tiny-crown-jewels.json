    {
      "text": "Queen Mary's dollhouse holds tiny Crown Jewels.",
      "scene": {
        "kind": "hook"
      }
    },
    {
      "text": "Architect Edwin Lutyens designed it as a gift for Queen Mary.",
      "scene": {
        "kind": "real",
        "src": "533-queen-mary-s-dollhouse-holds-tiny-crown-jewels-0.jpg",
        "fit": "card",
        "label": "Queen Mary's Dolls' House",
        "credit": "Public domain, via Wikimedia Commons"
      }
    },
    {
      "text": "Everything in it is built at one inch to the foot.",
      "scene": {
        "kind": "piece",
        "piece": "stone",
        "stone": "topaz",
        "metal": "yellow",
        "label": "One inch to the foot",
        "cut": "emerald"
      }
    },
    {
      "text": "Its strong room holds a full set of miniature Crown Jewels.",
      "scene": {
        "kind": "piece",
        "piece": "band",
        "stone": "citrine",
        "metal": "platinum",
        "label": "Miniature Crown Jewels"
      }
    },
    {
      "text": "The tiny crowns are set with real gems and seed pearls.",
      "scene": {
        "kind": "piece",
        "piece": "eternity",
        "stone": "emerald",
        "metal": "yellow",
        "label": "Real gems",
        "stones": 9
      }
    },
    {
      "text": "The miniature sceptre is only 8 centimeters long.",
      "say": "The miniature sceptre is only eight centimeters long.",
      "scene": {
        "kind": "title",
        "text": "8 cm",
        "sub": "The sceptre",
        "piece": "ring",
        "stone": "ruby",
        "metal": "platinum",
        "cut": "oval"
      }
    },
    {
      "text": "Cartier made seven working clocks for the house.",
      "scene": {
        "kind": "piece",
        "piece": "bracelet",
        "stone": "aquamarine",
        "metal": "platinum",
        "label": "Seven working clocks"
      }
    },
    {
      "text": "A tiny Faberge mouse was added to the house.",
      "say": "A tiny Fab er zhay mouse was added to the house.",
      "scene": {
        "kind": "piece",
        "piece": "ring",
        "stone": "pink",
        "metal": "yellow",
        "label": "A Faberge mouse",
        "cut": "cushion"
      }
    },
    {
      "text": "Author George Bernard Shaw declined to write a tiny book for it.",
      "scene": {
        "kind": "piece",
        "piece": "necklace",
        "stone": "emerald",
        "metal": "platinum",
        "label": "A refused book",
        "cut": "emerald"
      }
    },
    {
      "text": "It has been kept at Windsor Castle since 1925.",
      "say": "It has been kept at Windsor Castle since nineteen twenty five.",
