    {
      "text": "Katz thought she wanted to buy them.",
      "scene": {
        "kind": "piece",
        "piece": "band",
        "stone": "citrine",
        "metal": "platinum",
        "label": "A misunderstanding"
      }
    },
    {
      "text": "He told her he didn't loan jewelry.",
