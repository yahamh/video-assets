        "cast": [
          { "outfit": "casual", "outfitColor": "#ec6a9c", "hair": "long", "hairColor": "#7a4a2a", "skin": "#f1cfb0", "expression": "smile", "jewel": "pendant", "jewelTone": "#9a7cc9" },
          { "outfit": "casual", "outfitColor": "#4cc3a8", "hair": "short", "hairColor": "#4a3324", "skin": "#efc9a6", "expression": "proud", "prop": "pearl", "propTone": "#9a7cc9" }
