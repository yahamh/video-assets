  "lines": [
    {
      "text": "Oz's Emerald City wasn't green.",
      "scene": {
        "kind": "hook"
      }
    },
    {
      "text": "At the gate, the guard fits every visitor with green spectacles.",
      "scene": {
        "kind": "piece",
        "piece": "stone",
        "stone": "topaz",
        "metal": "platinum",
        "label": "Green spectacles",
        "cut": "emerald"
      }
    },
    {
      "text": "He says the city's brightness and glory would blind them.",
      "scene": {
        "kind": "piece",
        "piece": "band",
        "stone": "citrine",
        "metal": "yellow",
        "label": "Too bright"
      }
    },
    {
      "text": "The spectacles lock on, and he holds the only key.",
      "scene": {
        "kind": "piece",
        "piece": "eternity",
        "stone": "emerald",
        "metal": "platinum",
        "label": "Locked on",
        "stones": 9
      }
    },
    {
      "text": "Even the people who live in the city wear them.",
      "scene": {
        "kind": "piece",
        "piece": "bracelet",
        "stone": "aquamarine",
        "metal": "yellow",
        "label": "Everyone wears them"
      }
    },
    {
      "text": "The streets show houses of green marble studded with emeralds.",
      "scene": {
        "kind": "piece",
        "piece": "ring",
        "stone": "pink",
        "metal": "platinum",
        "label": "Studded with emeralds",
        "cut": "cushion"
      }
    },
    {
      "text": "Shoppers pay with green pennies and drink green lemonade.",
      "scene": {
        "kind": "piece",
        "piece": "earrings",
        "stone": "morganite",
        "metal": "yellow",
        "label": "Green pennies",
        "cut": "pear"
      }
    },
    {
      "text": "Later, the Wizard admits the city is no greener than any other.",
      "scene": {
        "kind": "real",
        "src": "614-oz-s-emerald-city-wasn-t-green-0.jpg",
        "fit": "card",
        "label": "A Denslow illustration, 1900",
        "credit": "Public domain, via Wikimedia Commons"
      }
    },
    {
      "text": "He put green spectacles on everyone so everything they saw was green.",
      "scene": {
        "kind": "piece",
        "piece": "stone",
        "stone": "tanzanite",
        "metal": "platinum",
        "label": "Everything green",
        "cut": "oval"
      }
    },
    {
      "text": "Baum's 1900 first edition ran 10,000 copies and sold out.",
      "say": "Bawm's nineteen hundred first edition ran ten thousand copies and sold out.",
      "scene": {
        "kind": "real",
        "src": "614-oz-s-emerald-city-wasn-t-green-1.jpg",
        "fit": "card",
        "label": "The 1900 first edition",
