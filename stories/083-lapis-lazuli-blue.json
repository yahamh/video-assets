  "lines": [
    {
      "text": "Egypt's blue stone came from Afghanistan.",
      "scene": {
        "kind": "hook",
        "show": "gem",
        "shape": "oval",
        "tone": "#2a4fb0"
      }
    },
    {
      "text": "The stone is called lapis lazuli.",
      "scene": {
        "kind": "title",
        "text": "Lapis lazuli",
        "sub": "Lapis is Latin for stone"
      }
    },
    {
      "text": "A famed source is Sar-e-Sang, in Badakhshan, Afghanistan.",
      "scene": {
        "kind": "cast",
        "setting": "mine",
        "name": "A miner in Badakhshan",
        "role": "Sar-e-Sang, Afghanistan",
        "cast": [
          {
            "outfit": "coat",
            "outfitColor": "#6a5a42",
            "hair": "short",
            "hairColor": "#2a1e18",
            "skin": "#c99a72",
            "expression": "smile",
            "hat": "cap"
          }
        ]
      }
    },
    {
      "text": "Lapis found at Ur likely came from Badakhshan.",
      "scene": {
        "kind": "title",
        "text": "The city of Ur",
        "sub": "Lapis likely from Badakhshan"
      }
    },
    {
      "text": "Traders carried it west to Mesopotamia and on to Egypt.",
      "scene": {
        "kind": "cast",
        "setting": "street",
        "name": "Traders",
        "role": "Carried it west",
        "cast": [
          {
            "outfit": "coat",
            "outfitColor": "#8a5a3a",
            "hair": "short",
            "hairColor": "#2a1e18",
            "skin": "#d9a77a",
            "expression": "smile",
            "facial": "beard"
          }
        ]
      }
    },
    {
      "text": "Tutankhamun's gold mask also uses lapis lazuli.",
      "scene": {
        "kind": "title",
        "text": "Tutankhamun",
        "sub": "His gold mask uses lapis"
      }
    },
    {
      "text": "The golden flecks inside it are pyrite.",
      "scene": {
        "kind": "reveal",
        "item": "gem",
        "shape": "oval",
        "tone": "#2a4fb0",
        "label": "Golden flecks: pyrite"
      }
    },
    {
      "text": "Painters made a blue pigment from it, called ultramarine.",
      "scene": {
        "kind": "cast",
        "setting": "plain",
        "name": "A painter",
        "role": "Made ultramarine blue",
        "cast": [
          {
            "outfit": "coat",
            "outfitColor": "#4a5a7a",
            "hair": "side",
            "hairColor": "#5a3a2a",
            "skin": "#efc9a6",
            "expression": "smile"
          }
        ]
      }
    },
    {
      "text": "Ultramarine comes from Latin words for beyond the sea.",
      "scene": {
        "kind": "title",
        "text": "Ultramarine",
        "sub": "Beyond the sea"
      }
    },
    {
      "text": "It was said to rival gold in price.",
      "scene": {
        "kind": "jewel",
        "piece": "necklace",
        "tone": "#2a4fb0",
        "metal": "yellow",
        "label": "Said to rival gold"
      }
    },
    {
      "text": "Painters often saved it for the Virgin Mary's clothing.",
      "scene": {
        "kind": "reveal",
        "item": "gem",
        "shape": "cushion",
        "tone": "#2a4fb0",
        "label": "For the Virgin Mary's clothing"
      }
    },
    {
      "text": "Vermeer used a lot of it in Girl with a Pearl Earring.",
      "scene": {
        "kind": "cast",
        "setting": "study",
        "name": "Vermeer",
        "role": "Girl with a Pearl Earring",
        "cast": [
          {
            "outfit": "coat",
            "outfitColor": "#3a3a46",
            "hair": "side",
            "hairColor": "#4a3426",
            "skin": "#efc9a6",
            "expression": "smile",
            "facial": "mustache"
          }
        ]
      }
    },
    {
      "text": "People have prized lapis for more than six thousand years.",
      "say": "People have prized lapis for more than six thousand years.",
      "scene": {
        "kind": "title",
        "text": "6,000+ years",
        "sub": "Of being prized"
      }
    }
  ],
  "post": {
    "caption": "Lapis is Latin for stone, and a famed source of lapis lazuli is Sar-e-Sang, in Badakhshan, Afghanistan. Traders carried it west to Mesopotamia and on to Egypt, and Tutankhamun's gold mask also uses it. Painters made the blue pigment ultramarine from it, a name from Latin words for beyond the sea.",
