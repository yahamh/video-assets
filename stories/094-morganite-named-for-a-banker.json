    {
      "text": "Morganite is named after a banker.",
      "scene": {
        "kind": "hook",
        "show": "gem",
        "shape": "cushion",
        "tone": "#f2a7b6",
        "color": "#5bb4e8"
      }
    },
    {
      "text": "Tiffany's gemologist George Kunz chose the name.",
      "scene": {
        "kind": "cast",
        "setting": "study",
        "name": "George Kunz",
        "role": "Tiffany's gemologist",
        "cast": [
          {
            "outfit": "suit",
            "outfitColor": "#3f5a6a",
            "hair": "side",
            "hairColor": "#7a5a3a",
            "skin": "#efc9a6",
            "expression": "smile",
            "facial": "mustache"
          }
        ],
        "color": "#4cc3a8"
      }
    },
    {
      "text": "It honors banker and gem collector John Pierpont Morgan.",
      "scene": {
        "kind": "title",
        "text": "A banker",
        "sub": "John Pierpont Morgan",
        "color": "#f7c23a"
      }
    },
    {
      "text": "Kunz helped Morgan build a great gem collection.",
      "scene": {
        "kind": "reveal",
        "item": "gem",
        "shape": "emerald",
        "tone": "#f2a7b6",
        "label": "A gem collection",
        "color": "#a98be0"
      }
    },
    {
      "text": "Much of it went to a New York museum.",
      "scene": {
        "kind": "title",
        "text": "A New York museum",
        "sub": "Morgan's gem collection",
        "color": "#5bb4e8"
      }
    },
    {
      "text": "Its first stones were found in Madagascar around 1910.",
      "say": "Its first stones were found in Madagascar around nineteen ten.",
      "scene": {
        "kind": "reveal",
        "item": "rough",
        "tone": "#f0b79a",
        "label": "First found in Madagascar",
        "color": "#c8dc3c"
      }
    },
    {
      "text": "Beryl also gives us emerald and aquamarine.",
      "scene": {
        "kind": "title",
        "text": "The beryl family",
        "sub": "Emerald and aquamarine",
        "color": "#ec6a9c"
      }
    },
    {
      "text": "Many morganites are heated to give a purer pink.",
      "scene": {
        "kind": "cast",
        "setting": "lab",
        "name": "A gem lab",
        "role": "Heating for a purer pink",
        "cast": [
          {
            "outfit": "coat",
            "outfitColor": "#a8506a",
            "hair": "updo",
            "hairColor": "#4a3224",
            "skin": "#efc9a6",
            "expression": "focused"
          }
        ],
        "color": "#f7c23a"
      }
    },
    {
      "text": "It ranks seven and a half to eight on the Mohs scale.",
      "scene": {
        "kind": "title",
        "text": "7.5 to 8",
        "sub": "On the Mohs scale",
        "color": "#4cc3a8"
      }
    },
    {
      "text": "It is a popular engagement ring stone, often set in rose gold.",
      "scene": {
        "kind": "jewel",
        "piece": "ring",
        "shape": "cushion",
        "tone": "#f2a7b6",
        "metal": "rose",
        "label": "Often set in rose gold",
        "color": "#5bb4e8"
      }
    },
    {
      "text": "Morganite is a pink variety of beryl.",
      "scene": {
