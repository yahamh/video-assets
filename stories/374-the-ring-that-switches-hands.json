        "kind": "piece",
        "piece": "ring",
        "stone": "diamond",
        "cut": "round",
        "metal": "platinum",
        "halo": 10,
        "label": "Engagement ring: left"
      }
    },
    {
      "text": "Many couples move it over to the right after the wedding.",
      "scene": {
        "kind": "piece",
        "piece": "band",
        "metal": "yellow",
        "stone": "topaz",
        "label": "Moved to the right"
      }
    },
    {
      "text": "The Orthodox Church traditionally has wedding rings on the right hand.",
      "scene": {
        "kind": "real",
        "src": "374-the-ring-that-switches-hands-0.jpg",
        "fit": "card",
        "label": "An Orthodox royal wedding",
        "credit": "Public domain, via Wikimedia Commons"
      }
    },
    {
      "text": "In the ceremony, the rings are exchanged three times.",
      "scene": {
        "kind": "title",
        "text": "Three times",
        "sub": "Exchanged",
        "piece": "eternity",
        "stone": "sapphire",
        "metal": "yellow",
        "stones": 12
      }
    },
    {
      "text": "Austria and Poland also wear wedding rings on the right.",
      "scene": {
        "kind": "piece",
        "piece": "band",
        "metal": "rose",
        "stone": "morganite",
        "label": "Austria and Poland"
      }
    },
    {
      "text": "In the US and UK, it goes on the left hand.",
      "say": "In the U S and U K, it goes on the left hand.",
      "scene": {
        "kind": "piece",
        "piece": "ring",
        "stone": "sapphire",
        "cut": "oval",
        "metal": "yellow",
        "label": "US and UK: left"
      }
    },
    {
      "text": "Dutch Catholics wear it on the left, and Protestants on the right.",
      "scene": {
        "kind": "piece",
        "piece": "stone",
        "stone": "peridot",
        "cut": "cushion",
        "metal": "platinum",
        "label": "The Netherlands"
      }
    },
    {
