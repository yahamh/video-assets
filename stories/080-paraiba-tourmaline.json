        ]
      }
    },
    {
      "text": "He dug for years near São José da Batalha, in Paraíba.",
      "say": "He dug for years near Sao Jose da Batalha, in Paraiba.",
      "scene": {
        "kind": "title",
        "text": "Paraíba, Brazil",
        "sub": "Near São José da Batalha"
      }
    },
    {
      "text": "The digging began in the early 1980s.",
      "say": "The digging began in the early nineteen eighties.",
      "scene": {
        "kind": "title",
        "text": "Early 1980s",
        "sub": "The digging begins"
      }
    },
    {
      "text": "In 1989, the first gem quality stones reached the market.",
      "say": "In nineteen eighty-nine, the first gem quality stones reached the market.",
      "scene": {
        "kind": "title",
        "text": "1989",
        "sub": "Gems reach the market"
      }
    },
    {
      "text": "They glowed neon blue to green.",
      "scene": {
        "kind": "reveal",
        "item": "gem",
        "shape": "oval",
        "tone": "#19b5d6",
        "label": "Neon blue to green"
      }
    },
    {
      "text": "Copper makes the color, a first documented in tourmaline.",
      "scene": {
        "kind": "title",
        "text": "Copper",
        "sub": "A documented first"
      }
    },
    {
      "text": "At the 1990 Tucson show, the price rose about tenfold.",
      "say": "At the nineteen ninety Tucson show, the price rose about tenfold.",
      "scene": {
        "kind": "title",
        "text": "About tenfold",
        "sub": "At Tucson, 1990"
      }
    },
    {
      "text": "Copper tourmaline later turned up in Nigeria and Mozambique.",
