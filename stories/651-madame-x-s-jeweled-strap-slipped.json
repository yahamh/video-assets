    {
      "text": "Madame X's jeweled strap slipped.",
      "scene": {
        "kind": "hook"
      }
    },
    {
      "text": "John Singer Sargent painted Virginie Gautreau in a black satin dress.",
      "scene": {
        "kind": "real",
        "src": "651-madame-x-s-jeweled-strap-slipped-0.jpg",
        "fit": "card",
        "label": "Madame X, 1884",
        "credit": "Public domain, via Wikimedia Commons"
      }
    },
    {
      "text": "Jeweled straps held it up, and a diamond crescent crowned her hair.",
      "scene": {
        "kind": "real",
        "src": "651-madame-x-s-jeweled-strap-slipped-1.jpg",
        "fit": "card",
        "label": "A detail of the straps",
        "credit": "Public domain, via Wikimedia Commons"
      }
    },
    {
      "text": "At first, he painted her right strap sliding off her shoulder.",
      "scene": {
        "kind": "piece",
        "piece": "brooch",
        "stone": "amethyst",
        "metal": "platinum",
        "label": "A slipping strap",
        "cut": "round",
        "petals": 8
      }
    },
    {
      "text": "At the 1884 Paris Salon, it drew more ridicule than praise.",
      "say": "At the eighteen eighty four Paris Salon, it drew more ridicule than praise.",
      "scene": {
        "kind": "title",
        "text": "1884",
        "sub": "The Paris Salon",
        "piece": "brooch",
        "stone": "ruby",
        "metal": "platinum",
        "cut": "round",
        "petals": 8
      }
    },
    {
      "text": "Gautreau and her mother begged him to take it down.",
      "scene": {
        "kind": "piece",
        "piece": "stone",
        "stone": "topaz",
        "metal": "yellow",
        "label": "Take it down",
        "cut": "emerald"
      }
    },
    {
      "text": "He refused, but later painted the strap back on her shoulder.",
      "scene": {
        "kind": "piece",
        "piece": "band",
        "stone": "citrine",
        "metal": "platinum",
        "label": "A new strap"
      }
    },
    {
      "text": "He kept the portrait for decades.",
      "scene": {
        "kind": "real",
        "src": "651-madame-x-s-jeweled-strap-slipped-2.jpg",
        "fit": "card",
        "label": "Sargent in his studio",
        "credit": "Public domain, via Wikimedia Commons"
      }
    },
    {
      "text": "He asked that her name be dropped, so she became Madame X.",
      "scene": {
        "kind": "piece",
        "piece": "bracelet",
        "stone": "aquamarine",
        "metal": "platinum",
        "label": "Madame X"
      }
    },
    {
      "text": "In 1916, he sold it to the Metropolitan Museum of Art.",
      "say": "In nineteen sixteen, he sold it to the Metropolitan Museum of Art.",
      "scene": {
        "kind": "title",
        "text": "1916",
        "sub": "The Met",
        "piece": "necklace",
        "stone": "emerald",
        "metal": "yellow",
        "cut": "emerald"
      },
      "hold": 0.6
    }
