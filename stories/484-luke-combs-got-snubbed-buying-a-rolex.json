      "scene": {
        "kind": "piece",
        "piece": "stone",
        "stone": "amethyst",
        "cut": "cushion",
        "metal": "platinum",
        "label": "Madison Square Garden"
      }
    },
    {
      "text": "Suddenly, a watch had been on hold in the back.",
