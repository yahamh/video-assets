    {
      "text": "Chanel's cuffs came from a Sicilian duke.",
      "scene": {
        "kind": "hook"
      }
    },
    {
      "text": "Fulco di Verdura grew up in Palermo, Sicily.",
      "say": "Fool koh dee Vair DOO rah grew up in Palermo, Sicily.",
      "scene": {
        "kind": "title",
        "text": "Palermo",
        "sub": "Sicily",
        "piece": "ring",
        "stone": "emerald",
        "cut": "oval",
        "metal": "yellow"
      }
    },
    {
      "text": "His childhood home had a private zoo with a camel.",
      "scene": {
        "kind": "piece",
        "piece": "brooch",
        "stone": "citrine",
        "cut": "round",
        "petals": 8,
        "metal": "yellow",
        "label": "A zoo with a camel"
      }
    },
    {
      "text": "He spent most of his inheritance on one costume ball.",
      "scene": {
        "kind": "piece",
        "piece": "earrings",
        "stone": "topaz",
        "cut": "pear",
        "metal": "yellow",
        "label": "One costume ball"
      }
    },
    {
      "text": "Then Coco Chanel hired him in Paris, first for textiles.",
      "scene": {
        "kind": "real",
        "src": "412-chanel-s-cuffs-came-from-a-sicilian-duke-0.jpg",
        "fit": "card",
        "label": "Coco Chanel, 1920s",
        "credit": "Public domain, via Wikimedia Commons"
      }
    },
    {
      "text": "Soon he was designing her jewelry.",
      "scene": {
        "kind": "piece",
        "piece": "necklace",
        "stone": "peridot",
        "cut": "round",
        "metal": "yellow",
        "label": "Jewelry for Chanel"
      }
    },
    {
      "text": "His Maltese cross cuff mixed white enamel with colorful stones.",
      "scene": {
        "kind": "piece",
        "label": "The Maltese cross cuff"
      }
    },
    {
      "text": "Chanel wore the cuffs in a famous photograph.",
      "scene": {
        "kind": "piece",
        "piece": "ring",
        "stone": "aquamarine",
        "cut": "oval",
        "metal": "yellow",
        "label": "A famous photograph"
      }
    },
    {
      "text": "In 1939, he opened his own salon at 712 Fifth Avenue.",
      "say": "In nineteen thirty nine, he opened his own salon at seven twelve Fifth Avenue.",
      "scene": {
        "kind": "title",
        "text": "1939",
        "sub": "Fifth Avenue",
        "piece": "brooch",
        "stone": "ruby",
        "cut": "round",
        "petals": 9,
        "metal": "yellow"
      }
    },
    {
      "text": "Cole Porter backed the new salon.",
      "scene": {
        "kind": "piece",
        "piece": "eternity",
        "stone": "sapphire",
        "metal": "yellow",
        "stones": 12,
        "label": "Backed by Cole Porter"
      }
    },
    {
      "text": "He even set real seashells in gold and gems.",
      "scene": {
        "kind": "piece",
        "piece": "brooch",
        "stone": "peridot",
        "cut": "round",
        "petals": 7,
