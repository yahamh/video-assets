      "scene": {
        "kind": "title",
        "text": "New York",
        "sub": "1964"
      }
    },
    {
      "text": "for $2,450, with no word that it had belonged to the tsars.",
      "say": "for two thousand four hundred fifty dollars, with no word that it had belonged to the tsars.",
      "scene": {
        "kind": "title",
        "text": "$2,450",
        "sub": "Sold as a gold watch"
      }
    },
    {
      "text": "Later a Midwest scrap dealer paid $14,000 for its gold.",
