        "kind": "gift",
        "stone": "egg",
        "to": "For Maria",
        "date": "Easter 1887"
      }
    },
    {
      "text": "Fabergé's gold egg opened to show a lady's watch inside.",
      "say": "Fabber-zhay's gold egg opened to show a lady's watch inside.",
      "scene": {
        "kind": "cast",
        "setting": "workshop",
        "name": "Fabergé workshop",
