            "hair": "short",
            "hairColor": "#6a4a30",
            "skin": "#efc9a6",
            "expression": "focused",
            "hat": "cap",
            "prop": "rough",
            "propTone": "#d9e6ea"
          }
        ]
      }
    },
    {
      "text": "His mother gave it to a neighbor, Schalk van Niekerk.",
      "say": "His mother gave it to a neighbor, Schalk van Neekirk.",
      "scene": {
        "kind": "cast",
        "setting": "plain",
        "name": "Schalk van Niekerk",
        "role": "A neighbor",
        "cast": [
          {
            "outfit": "dress",
