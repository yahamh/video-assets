    {
      "text": "Tourmaline was once called an ash puller.",
      "scene": {
        "kind": "hook",
        "show": "gem",
        "shape": "emerald",
        "tone": "#2fae7a",
        "color": "#ec6a9c"
      }
    },
    {
      "text": "In the early 1700s, Dutch traders brought it from Ceylon.",
      "say": "In the early seventeen hundreds, Dutch traders brought it from Ceylon.",
      "scene": {
        "kind": "title",
        "text": "Ceylon",
        "sub": "Now Sri Lanka",
        "color": "#f7c23a"
      }
    },
    {
      "text": "They reportedly used heated stones to pull ash from their pipes.",
      "scene": {
        "kind": "cast",
        "setting": "ship",
        "name": "A Dutch trader",
        "role": "Pulling ash from a pipe",
        "cast": [
          {
            "outfit": "coat",
            "outfitColor": "#3f5a6a",
            "hair": "short",
            "hairColor": "#7a5a3a",
            "skin": "#efc9a6",
            "expression": "smile",
            "hat": "cap",
            "facial": "mustache"
          }
        ],
        "color": "#5bb4e8"
      }
    },
    {
      "text": "It can become electrically charged when heated or squeezed.",
      "scene": {
        "kind": "title",
        "text": "Electric charge",
        "sub": "From heat or squeezing",
        "color": "#a98be0"
      }
    },
    {
      "text": "Tourmaline has been used in pressure gauges.",
      "scene": {
        "kind": "reveal",
        "item": "gem",
        "shape": "emerald",
        "tone": "#2fae7a",
        "label": "Used in pressure gauges",
        "color": "#f7c23a"
      }
    },
    {
      "text": "The name is said to mean mixed gems in Sinhalese.",
      "scene": {
        "kind": "title",
        "text": "Mixed gems",
        "sub": "A Sinhalese word",
        "color": "#5bb4e8"
      }
    },
    {
      "text": "Tourmaline has one of the widest color ranges of any gem.",
      "scene": {
        "kind": "cast",
        "setting": "lab",
        "name": "A gemologist",
        "role": "A very wide color range",
        "cast": [
          {
            "outfit": "coat",
            "outfitColor": "#2f6f7a",
            "hair": "updo",
            "hairColor": "#3a2a1e",
            "skin": "#d9a87e",
            "expression": "focused"
          }
        ],
        "color": "#4cc3a8"
      }
    },
    {
      "text": "Watermelon tourmaline has a pink center and a green rim.",
      "scene": {
        "kind": "title",
        "text": "Pink and green",
        "sub": "Watermelon tourmaline",
        "color": "#ec6a9c"
      }
    },
    {
      "text": "Paraiba tourmaline is vivid blue-green, colored by copper.",
      "scene": {
        "kind": "reveal",
        "item": "gem",
        "shape": "pear",
        "tone": "#18c4c0",
        "label": "Colored by copper",
        "color": "#f7c23a"
      }
    },
    {
      "text": "Brazil is a major source of tourmaline.",
      "scene": {
        "kind": "title",
        "text": "Brazil",
        "sub": "A major source",
        "color": "#c8dc3c"
      }
    },
    {
      "text": "It ranks seven to seven and a half on the Mohs scale.",
      "scene": {
        "kind": "reveal",
        "item": "gem",
        "shape": "oval",
        "tone": "#2fae7a",
        "label": "Mohs 7 to 7.5",
        "color": "#5bb4e8"
      }
    },
    {
      "text": "Tourmaline is an October birthstone.",
      "scene": {
        "kind": "jewel",
