    },
    {
      "text": "On October 20, 1942, Peggy Guggenheim opened her gallery in New York.",
      "say": "On October twentieth, nineteen forty two, Peggy Guggenheim opened her gallery in New York.",
      "scene": {
        "kind": "real",
        "src": "504-peggy-guggenheim-wore-mismatched-earrings-0.jpg",
        "fit": "card",
        "label": "Peggy Guggenheim, 1958",
        "credit": "Public domain, via Wikimedia Commons"
      }
    },
    {
      "text": "She wore one earring by Tanguy and one by Calder.",
      "scene": {
        "kind": "piece",
        "piece": "brooch",
        "stone": "amethyst",
        "metal": "yellow",
        "label": "Tanguy and Calder",
        "cut": "round",
        "petals": 8
      }
    },
    {
      "text": "She said it showed her impartiality between Surrealist and Abstract art.",
      "scene": {
        "kind": "piece",
        "piece": "stone",
        "stone": "topaz",
        "metal": "yellow",
        "label": "Impartiality",
        "cut": "emerald"
      }
    },
    {
      "text": "Tanguy's earring was a tiny oil landscape painted on shell.",
      "scene": {
        "kind": "real",
        "src": "504-peggy-guggenheim-wore-mismatched-earrings-1.jpg",
        "fit": "card",
        "label": "A Tanguy painting, 1942",
        "credit": "Public domain, via Wikimedia Commons"
      }
    },
    {
      "text": "Calder's was a wire mobile in miniature.",
      "scene": {
        "kind": "real",
        "src": "504-peggy-guggenheim-wore-mismatched-earrings-2.jpg",
        "fit": "card",
        "label": "Calder and Villanueva, 1954",
        "credit": "Public domain, via Wikimedia Commons"
      }
    },
    {
      "text": "Calder first made jewelry for his sister's dolls.",
      "scene": {
        "kind": "piece",
        "piece": "bracelet",
        "stone": "aquamarine",
        "metal": "yellow",
        "label": "Doll jewelry"
      }
    },
    {
      "text": "He went on to make roughly 1,800 pieces of jewelry.",
      "say": "He went on to make roughly eighteen hundred pieces of jewelry.",
      "scene": {
        "kind": "title",
        "text": "1,800",
        "sub": "Pieces",
        "piece": "bracelet",
        "stone": "aquamarine",
        "metal": "yellow"
      }
    },
    {
