  "lines": [
    {
      "text": "Cleopatra reportedly drank a pearl in vinegar.",
      "scene": {
        "kind": "hook",
        "show": "pearl"
      }
    },
    {
      "text": "The Roman writer Pliny the Elder tells the story.",
      "scene": {
        "kind": "title",
        "text": "Pliny the Elder",
        "sub": "A Roman writer"
      }
    },
    {
      "text": "He says Cleopatra owned the two largest pearls in history.",
      "scene": {
        "kind": "cast",
        "setting": "palace",
        "name": "Cleopatra",
        "role": "Owned two giant pearls",
        "cast": [
          {
            "outfit": "gown",
            "outfitColor": "#2f6aa8",
            "hair": "updo",
            "hairColor": "#1e1a16",
            "skin": "#d9a77a",
            "expression": "smile",
            "jewel": "pearls"
          }
        ]
      }
    },
    {
      "text": "She wagered that one dinner would cost ten million sesterces.",
      "scene": {
        "kind": "title",
        "text": "10 million",
        "sub": "Sesterces for one dinner"
      }
    },
    {
      "text": "Antony laughed and asked for the bill.",
      "scene": {
        "kind": "cast",
        "setting": "palace",
        "name": "Mark Antony",
        "role": "Asked for the bill",
        "cast": [
          {
            "outfit": "coat",
            "outfitColor": "#8a3a3a",
            "hair": "short",
            "hairColor": "#3a2a1e",
            "skin": "#e8bf96",
            "expression": "smile"
          }
        ]
      }
    },
    {
      "text": "She dropped one pearl into vinegar and swallowed it.",
      "scene": {
        "kind": "reveal",
        "item": "pearl",
        "label": "Into the vinegar"
      }
    },
    {
      "text": "The judge, Lucius Plancus, stopped her there.",
      "scene": {
        "kind": "cast",
        "setting": "study",
        "name": "Lucius Plancus",
        "role": "The judge of the wager",
        "cast": [
          {
            "outfit": "coat",
            "outfitColor": "#6a6a52",
            "hair": "side",
            "hairColor": "#7a7a7a",
            "skin": "#efc9a6",
            "expression": "neutral",
            "facial": "beard"
          }
        ]
      }
    },
    {
      "text": "He ruled that Antony had lost the wager.",
      "scene": {
        "kind": "title",
        "text": "Antony lost",
        "sub": "The judge ruled"
      }
    },
    {
      "text": "Pliny says the other pearl was cut in half for Venus.",
      "scene": {
        "kind": "title",
        "text": "Cut in half",
        "sub": "For Venus, says Pliny"
      }
    },
    {
      "text": "Modern tests show vinegar can dissolve a pearl.",
      "scene": {
        "kind": "title",
        "text": "Modern tests",
        "sub": "Vinegar dissolves a pearl"
      }
    },
    {
      "text": "A whole pearl takes many hours to dissolve.",
      "scene": {
        "kind": "title",
        "text": "Many hours",
        "sub": "Not minutes"
      }
    },
    {
      "text": "A pearl is layers of calcium carbonate, which acid dissolves.",
      "scene": {
        "kind": "reveal",
        "item": "pearl",
        "halo": true,
        "label": "Calcium carbonate"
      }
    }
  ],
  "post": {
