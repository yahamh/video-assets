          {
            "x": 0.4,
            "y": 0.07,
            "text": "Cut corner",
            "at": 0.5
          }
        ]
      }
    },
    {
      "text": "Open facets show inclusions, so clarity matters more.",
      "scene": {
        "kind": "photo",
        "src": "mix585-render-front.webp",
        "label": "Clarity",
        "focus": {
          "x": 0.5,
          "y": 0.12,
          "k": 2.2
        }
      }
    },
    {
      "text": "Most are about one and a half times as long as wide.",
      "scene": {
        "kind": "title",
        "text": "1.5 : 1",
        "sub": "Length to width"
      }
    },
    {
      "text": "Its square sister, the Asscher cut, dates from 1902.",
      "say": "Its square sister, the Asscher cut, dates from nineteen oh two.",
      "scene": {
        "kind": "title",
        "text": "Asscher",
        "sub": "Square, 1902"
