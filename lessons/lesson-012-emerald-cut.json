      "scene": {
        "kind": "title",
        "text": "1500s",
        "sub": "First for emeralds"
      }
    },
    {
      "text": "The cut corners help keep a stone from chipping.",
      "scene": {
        "kind": "photo",
        "src": "refine-after.webp",
        "label": "Cut corners",
        "focus": {
          "x": 0.48,
          "y": 0.12,
