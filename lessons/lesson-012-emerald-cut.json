        "after": "mix585-front-render.webp"
      }
    },
    {
      "text": "Its facets run in flat rows like stairs, a step cut.",
      "scene": {
        "kind": "photo",
        "src": "mix585-render-top.webp",
        "label": "Step cut",
        "focus": {
