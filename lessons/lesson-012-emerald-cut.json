            "at": 0.5
          }
        ]
      }
    },
    {
      "text": "Instead of tiny sparkles, it shows broad flashes of light.",
      "scene": {
        "kind": "photo",
        "src": "mix585-render-three-quarter.webp",
        "label": "Broad flashes",
        "focus": {
          "x": 0.57,
          "y": 0.16,
          "k": 2.2
        }
      }
    },
    {
      "text": "People call that look a hall of mirrors.",
