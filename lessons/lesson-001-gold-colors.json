    },
    {
      "text": "In yellow gold the rest is mostly silver, with about 10% copper.",
      "say": "In yellow gold the rest is mostly silver, with about ten percent copper.",
      "scene": {
        "kind": "mix",
        "src": "render-matthew-yellow.webp",
