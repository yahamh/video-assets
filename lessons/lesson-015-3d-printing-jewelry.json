          "Pure wax",
          "Resin"
        ],
        "active": 0,
        "label": "Two kinds of printer"
      }
    },
    {
      "text": "Many ring models can print together on one plate, in hours.",
      "scene": {
        "kind": "title",
        "text": "In hours",
        "sub": "Many rings on one plate"
      }
    },
    {
      "text": "Jewelers also print resin copies for clients to try on first.",
