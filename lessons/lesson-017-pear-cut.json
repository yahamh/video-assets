      "scene": {
        "kind": "title",
        "text": "58 facets",
        "sub": "Usually"
      }
    },
    {
      "text": "A Flemish cutter in Bruges is credited with it in the 1400s.",
      "say": "A Flemish cutter in Bruges is credited with it in the fourteen hundreds.",
      "scene": {
        "kind": "title",
        "text": "1400s",
        "sub": "Bruges"
      }
    },
    {
      "text": "Light often leaves a dark bow tie across the middle.",
      "scene": {
        "kind": "photo",
        "src": "pendant-pear-render.webp",
        "label": "The middle",
        "focus": {
          "x": 0.52,
          "y": 0.66,
          "k": 2.2
        }
      }
    },
    {
      "text": "A pear is usually 1.45 to 1.75 times longer than wide.",
      "say": "A pear is usually one point four five to one point seven five times longer than wide.",
      "scene": {
        "kind": "title",
        "text": "1.45 to 1.75",
        "sub": "Length to width"
      }
    },
    {
      "text": "The point is fragile, so a prong usually covers it.",
      "say": "The point is fragile, so a prong usually covers it.",
      "scene": {
