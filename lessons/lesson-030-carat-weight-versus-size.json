      "scene": {
        "kind": "title",
        "text": "200 mg",
        "sub": "One carat is"
      }
    },
    {
      "text": "A round diamond of one carat measures about 6.4 millimeters.",
      "say": "A round diamond of one carat measures about six point four millimeters.",
      "scene": {
        "kind": "title",
        "text": "About 6.4 mm",
        "sub": "One carat, round"
      }
    },
    {
      "text": "Double the weight makes it only about a quarter wider.",
      "scene": {
        "kind": "title",
        "text": "A quarter wider",
        "sub": "At double the weight"
      }
    },
    {
      "text": "A denser stone, like sapphire, looks smaller at the same carat weight.",
      "scene": {
        "kind": "photo",
        "src": "signet-render.webp",
        "focus": {
          "x": 0.5,
          "y": 0.3,
          "k": 1.5
        },
        "label": "Sapphires"
      }
    },
    {
      "text": "Ovals and pears often look larger per carat than round stones.",
      "scene": {
        "kind": "photo",
        "src": "pendant-pear-render.webp",
        "focus": {
          "x": 0.5,
          "y": 0.58,
          "k": 1.7
        },
        "label": "Pear shape"
      }
    },
    {
      "text": "A deep cut hides weight below the girdle.",
      "scene": {
        "kind": "title",
        "text": "Deep cut",
        "sub": "Hides weight below"
      }
    },
    {
      "text": "Total carat weight adds up every diamond in a piece.",
