          "Claw",
          "V",
          "Tab"
        ],
        "active": 1,
        "label": "Prong tips"
      }
    },
    {
      "text": "V-prongs guard the fragile points of pear and marquise cuts.",
      "say": "Vee prongs guard the fragile points of pear and marquise cuts.",
      "scene": {
        "kind": "steps",
        "items": [
          "Round",
          "Claw",
          "V",
          "Tab"
        ],
        "active": 2,
        "label": "Prong tips"
      }
    },
    {
      "text": "Flat tab prongs suit square and rectangular stones.",
      "scene": {
        "kind": "title",
        "text": "Tab prongs",
        "sub": "Square and rectangular"
      }
    },
    {
      "text": "Prongs wear down, so jewelers suggest checking them every six months.",
